<script>try{var t=localStorage.getItem("sfx_theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<style>
:root{--bg:#0b0906;--bg2:#15110a;--card:#1b160d;--line:#3a2e14;--gold:#f5b301;--gold2:#ffd84d;--txt:#f3ead6;--muted:#b9ad90;--green:#22c55e;--red:#ef4444;--strong:#fff;--hdr:rgba(11,9,6,.92);--th:#241c0d;--track:#2b2415;--glow:#3a2600;--chartbg:#120e07;--grid:rgba(255,204,85,.08);--ctabg:linear-gradient(135deg,#2a1d04,#120d05);--h1a:#fffbe6;--h1b:#ffd84d;--h1c:#f5b301;--box:#1b160d}
html[data-theme=light]{--bg:#faf7f0;--bg2:#fff;--card:#fff;--line:#e6dbc1;--gold:#e0a100;--gold2:#a86f00;--txt:#221b0c;--muted:#6e6350;--green:#16a34a;--red:#dc2626;--strong:#14100a;--hdr:rgba(250,247,240,.94);--th:#f6ecd2;--track:#ece3cd;--glow:#ffe9b0;--chartbg:#fffdf8;--grid:rgba(120,90,20,.10);--ctabg:linear-gradient(135deg,#fff4d6,#fffaf0);--h1a:#a86f00;--h1b:#d99a00;--h1c:#7a4f00;--box:#fff}
.theme{background:none;border:1px solid var(--gold);color:var(--gold2);border-radius:30px;width:36px;height:30px;cursor:pointer;font-size:15px;line-height:1}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--txt);line-height:1.65;min-height:100vh;display:flex;flex-direction:column}
a{color:var(--gold2)}
.wrap{max-width:1080px;margin:0 auto;padding:0 18px;width:100%}
header{position:sticky;top:0;z-index:10;background:var(--hdr);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px;gap:12px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--strong);font-weight:900;letter-spacing:1px;font-size:18px}
.brand .logo{width:38px;height:38px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff3b0,#f5c542 40%,#a86f00);display:grid;place-items:center;color:#2a1a00;font-weight:900;box-shadow:0 0 14px rgba(255,190,40,.5)}
.brand b{color:var(--gold)}
.nav-r{display:flex;gap:8px;align-items:center}
.lang{display:flex;border:1px solid var(--gold);border-radius:30px;overflow:hidden}
.lang button{background:none;border:0;color:var(--gold2);font-weight:800;padding:6px 12px;cursor:pointer;font-size:13px}
.lang button.on{background:var(--gold);color:#1a0f00}
.btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(90deg,var(--gold),var(--gold2));color:#1a0f00;font-weight:800;text-decoration:none;padding:12px 22px;border-radius:40px;border:0;cursor:pointer;font-size:15px}
.btn.ghost{background:none;color:var(--gold2);border:1.5px solid var(--gold)}
.btn.sm{padding:7px 14px;font-size:13px}
main{flex:1}
.hero{padding:70px 0 50px;text-align:center;background:radial-gradient(ellipse at 50% 0%,var(--glow) 0%,transparent 65%)}
.hero .badge{width:150px;margin:0 auto 18px}
.hero h1{font-size:clamp(30px,6vw,52px);line-height:1.1;font-weight:900}
.hero h1 span{background:linear-gradient(180deg,var(--h1a),var(--h1b) 40%,var(--h1c) 70%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--muted);max-width:640px;margin:16px auto 26px;font-size:17px}
.stats{display:flex;justify-content:center;gap:28px;flex-wrap:wrap;margin-top:30px;color:var(--muted);font-size:14px}
.stats b{display:block;color:var(--gold2);font-size:24px}
h2.sec{font-size:28px;font-weight:900;margin:40px 0 20px}
.levels{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;padding-bottom:40px}
.lv{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px;display:flex;gap:18px;align-items:flex-start;text-decoration:none;color:inherit;transition:.2s}
.lv:hover{border-color:var(--gold);transform:translateY(-2px)}
.lv svg{flex:none;width:86px;height:86px}
.lv small{color:var(--muted);font-size:12px;letter-spacing:2px;text-transform:uppercase}
.lv h3{font-size:21px;margin:2px 0 6px;color:var(--strong)}
.lv p{color:var(--muted);font-size:14px}
.bar{height:8px;border-radius:8px;background:var(--track);margin-top:12px;overflow:hidden}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--gold),var(--green));width:0}
.lv.soon{opacity:.5;pointer-events:none}
.lvhead{display:flex;gap:28px;align-items:center;padding:50px 0 30px;flex-wrap:wrap;border-bottom:1px solid var(--line)}
.lvhead svg{width:150px;height:150px;flex:none}
.lvhead h1{font-size:40px;font-weight:900;line-height:1.1}
.lvhead p{color:var(--muted);margin:8px 0 16px;max-width:560px}
.grid2{display:grid;grid-template-columns:240px 1fr;gap:40px;padding:34px 0 60px}
@media(max-width:760px){.grid2{grid-template-columns:1fr;gap:20px}}
.prog h4,.outline h4{font-size:22px;margin-bottom:14px}
.prog .pct{font-size:42px;font-weight:900;color:var(--gold2)}
.outline ol{list-style:none;border-left:2px solid var(--line);margin-left:14px}
.outline li{position:relative;padding:0 0 22px 26px}
.outline li:before{content:"";position:absolute;left:-11px;top:2px;width:20px;height:20px;border-radius:50%;background:var(--bg);border:2px solid var(--gold)}
.outline li.done:before{background:var(--green);border-color:var(--green)}
.outline a{color:var(--strong);text-decoration:none;font-weight:700;font-size:17px}
.outline a:hover{color:var(--gold2)}
.outline p{color:var(--muted);font-size:14px;margin-top:3px}
.lesson{max-width:760px;margin:0 auto;padding:40px 0 60px}
.crumb{font-size:13px;color:var(--muted);margin-bottom:14px}
.crumb a{color:var(--muted)}
.lesson h1{font-size:clamp(28px,5vw,40px);line-height:1.15;font-weight:900;margin-bottom:10px}
.lesson .lead{color:var(--muted);font-size:18px;margin-bottom:28px}
.lesson h2{font-size:24px;margin:30px 0 10px;color:var(--gold2)}
.lesson h3{font-size:19px;margin:22px 0 8px}
.lesson p{margin:0 0 14px}
.lesson ul,.lesson ol{margin:0 0 16px 22px}
.lesson li{margin-bottom:6px}
.box{border-radius:14px;padding:16px 18px;margin:20px 0;border:1px solid var(--line);background:var(--card)}
.box.tip{border-left:4px solid var(--green)}
.box.warn{border-left:4px solid var(--red)}
.box.ex{border-left:4px solid var(--gold)}
.box b.t{display:block;margin-bottom:4px;color:var(--strong)}
table{width:100%;border-collapse:collapse;margin:16px 0;font-size:15px}
th,td{border:1px solid var(--line);padding:9px 10px;text-align:left}
th{background:var(--th);color:var(--gold2)}
.pager{display:flex;justify-content:space-between;gap:12px;margin-top:40px;flex-wrap:wrap}
.done-btn{margin-top:30px}
.cta{background:var(--ctabg);border:1px solid var(--gold);border-radius:22px;padding:30px;text-align:center;margin:20px 0 60px}
.cta h3{font-size:24px;margin-bottom:8px}
.cta p{color:var(--muted);margin-bottom:18px}
.cta .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
footer{border-top:1px solid var(--line);padding:26px 0;color:var(--muted);font-size:13px}
footer .wrap{display:flex;flex-direction:column;gap:8px}
svg.chart{width:100%;height:auto;background:var(--chartbg);border-radius:14px;border:1px solid var(--line);margin:10px 0 18px}
.chap{margin-bottom:26px}
.chap-h{display:flex;gap:14px;align-items:flex-start;margin-bottom:14px}
.chap-h .num{flex:none;width:44px;height:44px;border-radius:50%;background:linear-gradient(180deg,#ffd84d,#f5b301);color:#1a0f00;font-weight:900;font-size:20px;display:grid;place-items:center}
.chap-h h3{font-size:22px;color:var(--strong);line-height:1.2}
.chap-h p{color:var(--muted);font-size:14px}
.toc{display:flex;flex-direction:column;gap:6px;margin-top:22px;position:sticky;top:84px}
.toc a{color:var(--muted);text-decoration:none;font-size:14px;padding:6px 10px;border-left:2px solid var(--line)}
.toc a:hover{color:var(--gold2);border-color:var(--gold)}
@media(max-width:760px){.toc{position:static}}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:18px 0}
.pair .sym{grid-column:1/-1;text-align:center;font-weight:900;font-size:22px}.pair .sym span{display:inline-block;border:2px solid var(--gold);border-radius:10px;padding:4px 12px;margin:0 6px}
.pair .sym small{display:block;font-size:12px;color:var(--muted);font-weight:500;margin-top:6px}
.pair .side{border-radius:14px;padding:16px;border:2px solid}.pair .buy{border-color:var(--green)}.pair .sell{border-color:var(--red)}
.pair .side b{display:block;font-size:17px;margin-bottom:4px}.pair .buy b{color:var(--green)}.pair .sell b{color:var(--red)}
.pair .side p{margin:0;color:var(--muted);font-size:14px}
.steps{counter-reset:s;list-style:none;margin:16px 0!important}.steps li{counter-increment:s;position:relative;padding:10px 0 10px 52px;border-bottom:1px solid var(--line)}
.steps li:before{content:counter(s);position:absolute;left:0;top:8px;width:36px;height:36px;border-radius:50%;background:var(--gold);color:#1a0f00;font-weight:900;display:grid;place-items:center}
.pats{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin:16px 0}
.pat{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px;text-align:center;font-size:13px}
.pat svg{width:100%;height:110px}.pat b{display:block;font-size:14px;color:var(--strong)}.pat i{font-style:normal;color:var(--muted)}
.navl{display:flex;gap:16px;margin-right:10px}.navl a{color:var(--muted);text-decoration:none;font-weight:700;font-size:14px}.navl a:hover{color:var(--gold2)}
@media(max-width:700px){.navl{display:none}.brand span:last-child{font-size:15px}}
.mnav{display:none;gap:8px;justify-content:center;padding:8px 0;border-top:1px solid var(--line)}.mnav a{color:var(--muted);text-decoration:none;font-size:13px;font-weight:700;padding:4px 10px;border:1px solid var(--line);border-radius:20px}
@media(max-width:700px){.mnav{display:flex}}
.ui{position:relative;aspect-ratio:16/9;border:2px solid var(--line);border-radius:14px;background:var(--chartbg);margin:16px 0}.ui.phone{aspect-ratio:9/14;max-width:280px;margin:16px auto}
.uz{position:absolute;border:2px dashed var(--gold);border-radius:8px;background:rgba(245,179,1,.06);display:flex;align-items:center;justify-content:center;gap:6px;padding:4px;text-align:center;overflow:hidden}
.uz span{flex:none;width:24px;height:24px;border-radius:50%;background:var(--gold);color:#1a0f00;font-weight:900;font-size:13px;display:grid;place-items:center}.uz em{font-style:normal;font-size:12px;color:var(--txt);font-weight:600}
.sig{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--gold);border-radius:14px;padding:16px 18px;margin:16px 0;font-family:ui-monospace,Consolas,monospace;font-size:15px;line-height:1.8}.sig .sig-h{font-weight:900}.sig .sell{color:var(--red);font-weight:900}.sig .muted{color:var(--muted)}
.tl{border-left:3px solid var(--gold);margin:16px 0 16px 8px}.tl>div{position:relative;padding:4px 0 14px 70px}.tl b{position:absolute;left:14px;top:4px;color:var(--gold2);font-size:13px;width:52px}.tl span{margin-right:6px}.tl p{display:inline;margin:0}
.tl>div:before{content:"";position:absolute;left:-8px;top:9px;width:13px;height:13px;border-radius:50%;background:var(--gold)}
.check{display:flex;flex-direction:column;gap:8px;margin:16px 0}.check label{display:block;position:relative;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px 10px 40px;cursor:pointer}.check input{position:absolute;left:12px;top:13px;accent-color:var(--green);width:18px;height:18px;margin:0}
.check label:has(input:checked){border-color:var(--green)}.check.grid20{display:grid;grid-template-columns:repeat(auto-fill,minmax(70px,1fr))}.checkres{font-weight:800;color:var(--gold2)}
.goals{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;margin:10px 0 30px}.goal{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px}.goal i{font-style:normal;font-size:28px}.goal b{display:block;margin:6px 0 4px;color:var(--strong)}.goal p{color:var(--muted);font-size:14px;margin:0}
.path{display:flex;gap:0;flex-wrap:wrap;counter-reset:p;margin:10px 0 30px}.path a{flex:1 1 150px;text-decoration:none;color:var(--txt);padding:14px;border:1px solid var(--line);background:var(--card);position:relative;font-weight:700;font-size:14px}.path a small{display:block;color:var(--muted);font-weight:500}.path a:first-child{border-radius:14px 0 0 14px}.path a:last-child{border-radius:0 14px 14px 0}.path a:hover{border-color:var(--gold)}
@media(max-width:700px){.path a{flex-basis:100%;border-radius:10px!important;margin-bottom:6px}}
.quiz .q{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:14px}.quiz .q b{display:block;margin-bottom:8px;color:var(--strong)}
.quiz button.opt{display:block;width:100%;text-align:left;background:none;border:1px solid var(--line);color:var(--txt);border-radius:10px;padding:10px 12px;margin:6px 0;cursor:pointer;font-size:15px}.quiz button.opt:hover{border-color:var(--gold)}
.quiz button.ok{border-color:var(--green);background:rgba(34,197,94,.12)}.quiz button.ko{border-color:var(--red);background:rgba(239,68,68,.12)}.quiz .exp{color:var(--muted);font-size:14px;margin-top:6px}
.score{font-size:40px;font-weight:900;color:var(--gold2)}
.gl{display:grid;grid-template-columns:1fr;gap:8px}.gl div{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 14px}.gl b{color:var(--gold2)}
.search{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--txt);font-size:16px;margin:10px 0 16px}
canvas.cert{width:100%;height:auto;border-radius:12px;border:1px solid var(--line);margin:16px 0}
.qlink{display:inline-flex;margin-top:10px}
</style>
</head>
