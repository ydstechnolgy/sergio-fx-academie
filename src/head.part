/* ===================== BADGES (SVG) ===================== */
function badge(icon){
 const ic={
  coins:'<g fill="#f5b301" stroke="#1a0f00" stroke-width="2"><circle cx="52" cy="56" r="13"/><circle cx="72" cy="50" r="13"/><circle cx="62" cy="68" r="13"/></g><g fill="#1a0f00" font-weight="900" font-size="12" text-anchor="middle" font-family="Arial"><text x="52" y="60">$</text><text x="72" y="54">€</text><text x="62" y="72">£</text></g>',
  hand:'<path d="M38 64 l14-12 10 6 10-6 12 12 -12 10 -10-6 -10 6z" fill="#f5b301" stroke="#1a0f00" stroke-width="2"/><text x="62" y="46" fill="#ffd84d" font-size="13" font-weight="900" text-anchor="middle" font-family="Arial">¥ £ $</text>',
  candle:'<g stroke="#1a0f00" stroke-width="2"><line x1="50" y1="38" x2="50" y2="84" stroke="#22c55e"/><rect x="44" y="48" width="12" height="24" fill="#22c55e"/><line x1="74" y1="36" x2="74" y2="82" stroke="#ef4444"/><rect x="68" y="44" width="12" height="20" fill="#ef4444"/></g>'
 }[icon];
 return `<svg viewBox="0 0 124 124"><defs><linearGradient id="gd${icon}" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#ffe680"/><stop offset="1" stop-color="#b87400"/></linearGradient></defs>
 <path d="M62 8 L106 22 V60 C106 88 86 106 62 116 C38 106 18 88 18 60 V22 Z" fill="#1b160d" stroke="url(#gd${icon})" stroke-width="5"/>
 <path d="M62 18 L96 29 V60 C96 82 81 96 62 104 C43 96 28 82 28 60 V29 Z" fill="#2a2010"/>${ic}
 <g fill="#f5b301"><circle cx="40" cy="98" r="0"/></g></svg>`;
}

/* ===================== CONTENU DE LA FORMATION =====================
   Pour ajouter une leçon : copier un bloc { id, t:{fr,en}, s:{fr,en}, b:{fr,en} } dans "lessons".
