en:{tag:"Free course",heroT:'Learn trading <span>step by step</span>',heroP:"A simple course to understand Forex and Gold from scratch. Go at your own pace, one lesson at a time.",start:"Start the course",levels:"Levels",level:"Level",of:"of",lessons:"lessons",startLv:"Start",progress:"Your progress",outline:"Course outline",prev:"← Previous lesson",next:"Next lesson →",markDone:"✓ I've finished this lesson",isDone:"✓ Lesson completed",home:"Home",soon:"Coming soon",ctaT:"Ready to practise?",ctaP:"Open your account with our broker and join the VIP group: Gold signals and coaching.",ctaB1:"Open an HFM account",ctaB2:"Contact me on WhatsApp",backLv:"← Back to level",disc:"⚠️ Trading carries a high risk of losing capital. This content is educational and is not investment advice. Never trade with money you cannot afford to lose.",statL:"lessons",statN:"levels",statF:"100% free",complete:"completed"}
