/* ===================== ASSEMBLAGE DES NIVEAUX ===================== */
const LV1={n:1,icon:"coins",t:{fr:"Les bases du Forex",en:"Forex basics"},d:{fr:"Tu pars de zéro ? 10 chapitres pour comprendre le marché des devises, les ordres, la marge, la gestion du risque et MetaTrader 5.",en:"Starting from zero? 10 chapters to understand the currency market, orders, margin, risk management and MetaTrader 5."},chapters:[...CH_A,...CH_B,...CH_C]};
LV3.chapters[4].lessons=[OLD3.lessons[3]];LV3.chapters[5].lessons=[OLD3.lessons[4]];
LV3.chapters[4].lessons.forEach(x=>delete x.id);LV3.chapters[5].lessons.forEach(x=>delete x.id);
const COURSE=[LV1,LV2,LV3];
COURSE.forEach(c=>{
 if(!c.chapters)c.chapters=[{t:c.t,d:c.d,lessons:c.lessons}];
 c.chapters.forEach((ch,ci)=>ch.lessons.forEach((x,li)=>{if(!x.id)x.id=`${c.n}-${ci+1}-${li+1}`;x.ch=ch;x.chi=ci+1}));
 c.lessons=c.chapters.flatMap(ch=>ch.lessons);
});

/* ===================== MOTEUR DU SITE ===================== */
let LANG='fr';try{LANG=localStorage.getItem('sfx_lang')||'fr'}catch(e){}
let DONE={};try{DONE=JSON.parse(localStorage.getItem('sfx_done')||'{}')}catch(e){}
const save=()=>{try{localStorage.setItem('sfx_done',JSON.stringify(DONE));localStorage.setItem('sfx_lang',LANG)}catch(e){}};
const T=k=>UI[LANG][k];
const all=COURSE.flatMap(c=>c.lessons.map(x=>({...x,lv:c})));
const pct=c=>Math.round(100*c.lessons.filter(x=>DONE[x.id]).length/c.lessons.length);
const cta=()=>`<div class="cta"><h3>${T('ctaT')}</h3><p>${T('ctaP')}</p><div class="row"><a class="btn" href="${HFM}" target="_blank" rel="noopener">${T('ctaB1')}</a><a class="btn ghost" href="${WA}" target="_blank" rel="noopener">${T('ctaB2')}</a></div></div>`;
const CHW={fr:"Chapitre",en:"Chapter"};

function home(){
 return `<section class="hero"><div class="wrap"><div class="badge">${badge('coins')}</div>
 <h1>${T('heroT')}</h1><p>${T('heroP')}</p>
 <a class="btn" href="#/level/1">${T('start')} →</a>
 <div class="stats"><div><b>${COURSE.length}</b>${T('statN')}</div><div><b>${all.length}</b>${T('statL')}</div><div><b>FR / EN</b>${T('statF')}</div></div></div></section>
 <div class="wrap"><h2 class="sec">${T('levels')}</h2><div class="levels">
 ${COURSE.map(c=>`<a class="lv" href="#/level/${c.n}">${badge(c.icon)}<div><small>${T('level')} ${c.n}</small><h3>${c.t[LANG]}</h3><p>${c.d[LANG]}</p><p style="margin-top:6px;font-size:13px">${c.lessons.length} ${T('lessons')} · ${pct(c)}% ${T('complete')}</p><div class="bar"><i style="width:${pct(c)}%"></i></div></div></a>`).join('')}
 <div class="lv soon">${badge('coins')}<div><small>${T('level')} ${COURSE.length+1}</small><h3>${T('soon')}</h3></div></div>
 </div>${cta()}</div>`;
}
function level(n){
 const c=COURSE.find(x=>x.n==n);if(!c)return home();
 const multi=c.chapters.length>1;
 const chapters=c.chapters.map((ch,ci)=>`<section class="chap">${multi?`<div class="chap-h"><span class="num">${ci+1}</span><div><h3>${ch.t[LANG]}</h3><p>${ch.d[LANG]}</p></div></div>`:''}
  <ol>${ch.lessons.map(x=>`<li class="${DONE[x.id]?'done':''}"><a href="#/lesson/${x.id}">${x.t[LANG]}</a><p>${x.s[LANG]}</p></li>`).join('')}</ol></section>`).join('');
 return `<div class="wrap"><div class="lvhead">${badge(c.icon)}<div><small style="color:var(--muted)">${T('level')} ${c.n} ${T('of')} ${COURSE.length}</small><h1>${c.t[LANG]}</h1><p>${c.d[LANG]}</p><a class="btn" href="#/lesson/${c.lessons[0].id}">${T('startLv')} →</a></div></div>
 <div class="grid2"><div class="prog"><h4>${T('progress')}</h4><div class="pct">${pct(c)}%</div><div class="bar"><i style="width:${pct(c)}%"></i></div><p style="color:var(--muted);font-size:14px;margin-top:8px">${c.lessons.filter(x=>DONE[x.id]).length} / ${c.lessons.length} ${T('lessons')}</p>
 ${multi?`<nav class="toc">${c.chapters.map((ch,ci)=>`<a href="#/lesson/${ch.lessons[0].id}">${ci+1}. ${ch.t[LANG]}</a>`).join('')}</nav>`:''}</div>
 <div class="outline"><h4>${T('outline')}</h4>${chapters}</div></div>${cta()}</div>`;
}
function lesson(id){
 const i=all.findIndex(x=>x.id==id);if(i<0)return home();const x=all[i],p=all[i-1],nx=all[i+1];
 const multi=x.lv.chapters.length>1;
 return `<div class="wrap"><article class="lesson"><div class="crumb"><a href="#/">${T('home')}</a> › <a href="#/level/${x.lv.n}">${T('level')} ${x.lv.n} · ${x.lv.t[LANG]}</a>${multi?` › ${CHW[LANG]} ${x.chi} · ${x.ch.t[LANG]}`:''}</div>
 <h1>${x.t[LANG]}</h1><p class="lead">${x.s[LANG]}</p>${x.b[LANG]}
 <button class="btn ${DONE[x.id]?'ghost':''} done-btn" onclick="toggleDone('${x.id}')">${DONE[x.id]?T('isDone'):T('markDone')}</button>
 <div class="pager">${p?`<a class="btn ghost sm" href="#/lesson/${p.id}">${T('prev')}</a>`:`<span></span>`}${nx?`<a class="btn sm" href="#/lesson/${nx.id}">${T('next')}</a>`:`<a class="btn sm" href="#/level/${x.lv.n}">${T('backLv')}</a>`}</div>
 </article>${cta()}</div>`;
}
function toggleDone(id){DONE[id]=!DONE[id];if(!DONE[id])delete DONE[id];save();render()}
function render(){
 const h=location.hash.replace('#','')||'/';const [,a,b]=h.split('/');
 document.documentElement.lang=LANG;
 document.getElementById('app').innerHTML=a=='level'?level(b):a=='lesson'?lesson(b):home();
 document.getElementById('disc').textContent=T('disc');
 document.querySelectorAll('.lang button').forEach(x=>x.classList.toggle('on',x.dataset.l==LANG));
}
document.querySelectorAll('.lang button').forEach(x=>x.onclick=()=>{LANG=x.dataset.l;save();render()});
window.addEventListener('hashchange',()=>{render();scrollTo(0,0)});
const thB=document.getElementById('theme');const setTh=()=>{thB.textContent=document.documentElement.dataset.theme=='light'?'🌙':'☀️'};setTh();
thB.onclick=()=>{const d=document.documentElement;d.dataset.theme=d.dataset.theme=='light'?'dark':'light';try{localStorage.setItem('sfx_theme',d.dataset.theme)}catch(e){};setTh()};
document.getElementById('yr').textContent=new Date().getFullYear();
render();
</script>
</body>
</html>
